# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs (create these in Stripe dashboard)
STRIPE_MONTHLY_PRICE_ID=price_monthly_id_here
STRIPE_YEARLY_PRICE_ID=price_yearly_id_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_claude_api_key

# App
NEXT_PUBLIC_APP_URL=https://project-wbhr2.vercel.app

# Shared secret for server-to-server calls to /api/intent-engine (ReplyRush).
# Generate a long random value; set the same value in ReplyRush.
INTENT_ENGINE_SERVICE_KEY=generate_a_long_random_value

# Free-tier monthly quotas (5 scripts / 5 ideas / 3 captions). Usage is always
# counted; requests are only blocked when this is "true".
USAGE_LIMITS_ENFORCED=false
